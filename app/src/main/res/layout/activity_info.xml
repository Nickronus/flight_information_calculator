<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFF8E1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Справка"
            android:textColor="#5D4037"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отче наш, сущий на небесах!\n\nДа святится имя Твое;\n\nДа приидет Царствие Твое;\n\nДа будет воля Твоя и на земле, как на небе;\n\nХлеб наш насущный дай нам на сей день;\n\nИ прости нам долги наши, как и мы прощаем должникам нашим;\n\nИ не введи нас в искушение, но избавь нас от лукавого.\n\nИбо Твое есть Царство и сила и слава вовеки."
            android:textSize="18sp"
            android:textColor="#5D4037"
            android:lineSpacingExtra="8dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/amenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Аминь"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"/>

    </LinearLayout>
</ScrollView>