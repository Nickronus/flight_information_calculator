<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".calculate">

        <!-- Остаток топлива -->
        <LinearLayout
            android:id="@+id/remainingFuelContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОСТАТОК ТОПЛИВА (кг)"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/remainingFuelInput"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_border"
                android:gravity="center"
                android:hint="кг"
                android:inputType="number"
                android:maxLength="5"/>
        </LinearLayout>

        <!-- Время послеполётное -->
        <LinearLayout
            android:id="@+id/postFlightTimeContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/remainingFuelContainer">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ВРЕМЯ ПОСЛЕПОЛЁТНОЕ (мин)"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/postFlightMinutes"
                android:layout_width="95dp"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_border"
                android:gravity="center"
                android:hint="ММ"
                android:inputType="number"
                android:maxLength="3"/>
        </LinearLayout>

        <!-- Кнопка РАССЧИТАТЬ -->
        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="РАССЧИТАТЬ"
            android:textAllCaps="false"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/postFlightTimeContainer"/>

        <!-- Кнопка НАЗАД -->
        <Button
            android:id="@+id/btnBackBottom"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp"
            android:text="Назад"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCalculate"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>