<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".first">

    <!-- Заголовок -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/flightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Полёт 1"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Вперёд"/>
    </RelativeLayout>

    <!-- Предполётное время -->
    <LinearLayout
        android:id="@+id/preFlightTimeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Предполётное время (всего)"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <EditText
                android:id="@+id/preFlightMinutes"
                android:layout_width="89dp"
                android:layout_height="48dp"
                android:background="@drawable/edit_text_border"
                android:gravity="center"
                android:hint="ММ"
                android:inputType="number"
                android:maxLength="3"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Фактическая дата и время взлёта -->
    <LinearLayout
        android:id="@+id/takeoffDateTimeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/preFlightTimeContainer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Фактические дата и время взлёта"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- Дата взлёта -->
        <EditText
            android:id="@+id/takeoffDate"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:hint="дд.мм.гггг"
            android:inputType="date"
            android:gravity="center"
            android:background="@drawable/edit_text_border"/>

        <!-- Время взлёта -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <EditText
                android:id="@+id/takeoffHours"
                android:layout_width="50dp"
                android:layout_height="48dp"
                android:hint="ЧЧ"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:background="@drawable/edit_text_border"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="16sp"
                android:layout_marginHorizontal="4dp"/>

            <EditText
                android:id="@+id/takeoffMinutes"
                android:layout_width="50dp"
                android:layout_height="48dp"
                android:hint="ММ"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:background="@drawable/edit_text_border"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Планируемая дата и время взлёта -->
    <LinearLayout
        android:id="@+id/plannedTakeoffDateTimeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/takeoffDateTimeContainer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Планируемые дата и время взлёта"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <!-- Планируемая дата взлёта -->
        <EditText
            android:id="@+id/plannedTakeoffDate"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:hint="дд.мм.гггг"
            android:inputType="date"
            android:gravity="center"
            android:background="@drawable/edit_text_border"/>

        <!-- Планируемое время взлёта -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <EditText
                android:id="@+id/plannedTakeoffHours"
                android:layout_width="50dp"
                android:layout_height="48dp"
                android:hint="ЧЧ"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:background="@drawable/edit_text_border"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textSize="16sp"
                android:layout_marginHorizontal="4dp"/>

            <EditText
                android:id="@+id/plannedTakeoffMinutes"
                android:layout_width="50dp"
                android:layout_height="48dp"
                android:hint="ММ"
                android:inputType="number"
                android:maxLength="2"
                android:gravity="center"
                android:background="@drawable/edit_text_border"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопка ВЗЛЁТ -->
    <Button
        android:id="@+id/btnTakeoff"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="УСТАНОВИТЬ ТЕКУЩЕЕ ВРЕМЯ"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/plannedTakeoffDateTimeContainer"/>

    <!-- Кнопки НАЗАД и ДАЛЕЕ -->
    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnBackBottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Назад"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Далее"
            android:textAllCaps="false"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>