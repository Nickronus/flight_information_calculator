<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".next">
    <!-- Шапка (как в предыдущих формах) -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/flightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Полёт 1"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Назад"/>

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Вперёд"/>
    </RelativeLayout>

    <!-- Основные кнопки управления полётом -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBackBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- Кнопка ПРОДОЛЖИТЬ ПОЛЁТ -->
        <Button
            android:id="@+id/btnContinueFlight"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            android:text="НОВЫЙ ПОЛЁТ"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <!-- Кнопка ЗАВЕРШИТЬ ПОЛЁТ -->
        <Button
            android:id="@+id/btnFinishFlight"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:text="ЗАВЕРШИТЬ РЕЙС"
            android:textAllCaps="false"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Кнопка НАЗАД внизу экрана -->
    <Button
        android:id="@+id/btnBackBottom"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginBottom="40dp"
        android:text="Назад"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>